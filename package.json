{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "docker-build": "docker build -t internship-website .",
    "docker-rm": "docker rm -f internship-website",
    "docker-run": "docker run -d --name internship-website -p 8002:80 internship-website",
    "preview": "vite preview",
    "lint": "eslint --fix \"./src/**/*.{js,jsx,ts,tsx,json}\"",
    "format": "prettier --write \"./src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "pretest": "vite build --mode=test",
    "test": "vitest run",
    "deploy": "npm run docker-build && npm run docker-rm && npm run docker-run"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@dpawlikowski/liquid-glass": "^0.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@paper-design/shaders-react": "^0.0.82",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@shadergradient/react": "^2.4.20",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "camera-controls": "^3.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "framer-motion": "^12.38.0",
    "gsap": "^3.15.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "prettier": "^3.8.3",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "shadcn": "^4.7.0",
    "tailwind-merge": "^3.6.0",
    "three": "^0.187.0",
    "three-stdlib": "^2.36.1",
    "tw-animate-css": "^1.4.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.187.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
